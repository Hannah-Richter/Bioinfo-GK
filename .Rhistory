log.pred <- factor(ifelse(predict(log.reg, prediction) > 0.5, "Late", "Early"))
ggplot() +
geom_bar(aes(x=rf.pred), color="black", fill="white") +
labs(title="Distribution in Random Forest Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=log.pred), color="black", fill="white") +
labs(title="Distribution in Multinomial Logistic Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=train$Tumor.stage), color="black", fill="white") +
labs(title="Distribution in Training Data") +
theme_bw()
selector <- sample(annot$barcode, nrow(annot)/2)
anti.selector <- annot$barcode[!{annot$barcode %in% selector}]
train.annot <- column_to_rownames(annot, "barcode")
train.annot$Tumor.stage <- train.annot$Tumor.stage %>% sapply(function(x) {
if (x == "Stage IA" || x == "Stage IB" || x == "Stage IIA" || x == "Stage IIB") return("Early") else return("Late")
}) %>% factor()
prediction.annot <- train.annot
train.annot <- train.annot[selector,]
train.exp <- exp[,match(selector, colnames(exp))]
exp.var <- train.exp %>% apply(1, var)
t50.train.exp.var <- t(train.exp[names(sort(exp.var)[1:50]),])
train <- data.frame(train.annot$Tumor.stage, t50.train.exp.var)
colnames(train) <- c("Tumor.stage", colnames(train)[-1])
rf.reg <- randomForest(Tumor.stage ~ ., data = train, importance = TRUE, ntree = 500)
log.reg <- glm(Tumor.stage ~ ., data = train, family = "binomial")
prediction.annot <- prediction.annot[anti.selector,]
prediction.exp <- exp[,match(anti.selector, colnames(exp))]
t50.predict.exp.var <- t(prediction.exp[names(sort(exp.var)[1:50]),])
prediction <- data.frame(factor(prediction.annot$Tumor.stage), t50.predict.exp.var)
colnames(prediction) <- c("Tumor.stage", colnames(prediction)[-1])
rf.pred <- predict(rf.reg, prediction)
log.pred <- factor(ifelse(predict(log.reg, prediction) > 0.5, "Late", "Early"))
ggplot() +
geom_bar(aes(x=rf.pred), color="black", fill="white") +
labs(title="Distribution in Random Forest Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=log.pred), color="black", fill="white") +
labs(title="Distribution in Multinomial Logistic Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=train$Tumor.stage), color="black", fill="white") +
labs(title="Distribution in Training Data") +
theme_bw()
