log.abs.imp <- abs_imper(log.reg, mode="binom") %>% sort(., T) %>% names() %>% .[1:50]
rf.abs.imp[rf.abs.imp %in% log.abs.imp]
rf.abs.imp
log.abs.imp
rf.abs.imp <- abs_imper(rf.reg, mode="rf") %>% sort(., T) %>% names() %>% .[1:50]
log.abs.imp <- abs_imper(log.reg, mode="binom") %>% sort(., T) %>% names() %>% .[1:50]
rf.abs.imp %in% log.abs.imp
rf.abs.imp
log.abs.imp
rf.abs.imp <- abs_imper(rf.reg, mode="rf") %>% sort(., T) %>% names() %>% .[1:50]
log.abs.imp <- abs_imper(log.reg, mode="binom") %>% sort(., T) %>% names() %>% .[1:50]
rf.abs.imp[rf.abs.imp %in% log.abs.imp]
rf.abs.imp <- abs_imper(rf.reg, mode="rf") %>% sort(., T) %>% names() %>% .[1:20]
log.abs.imp <- abs_imper(log.reg, mode="binom") %>% sort(., T) %>% names() %>% .[1:20]
rf.abs.imp[rf.abs.imp %in% log.abs.imp]
