text_NA_remover <- function(data) {
as.data.frame(apply(data, 2, function(x) {
x[which(x=="[unknown]" | x=="[not available]" | x=="[Not Available]")] <- NA
return(x)
}))
}
NA_counter <- function(data) {
sum(apply(data, 2, function(k) sum(is.na(k))))
}
