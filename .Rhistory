head(annot)
annot$paper_patient <- strtrim(annot$barcode, 12)
annot <- annot[, c("barcode", grep("^paper_", colnames(annot), value = TRUE))]
length(grep("paper", colnames(annot)))
NA_flattener <- function(data) {
for (i in seq_along(data)) {
data[tolower(data[[i]]) %in% c("[unknown]","[not available]"), i ] <- NA
}
data
}
NA_counter <- function(data, per_col=F) {
s <- apply(data, 2, function(k) sum(is.na(k)))
if (per_col) return(s) else return (sum(s))
}
colnames(annot) <- c(colnames(annot)[1], colnames(annot)[-1] %>% substring(7))
annot$Tumor.stage <- luad_anot_clean$ajcc_pathologic_stage
annot <- NA_flattener(annot)
annot %>% NA_counter(per_col=T) # No NAs in barcode
length(annot$barcode) == length(unique(annot$barcode)) # barcodes can function as unique keys
annot <- column_to_rownames(annot, "barcode") # Don't like tibbles and their zero-name convention nonsense
exp <- luad_exp_clean
exp <- NA_flattener(exp)
exp %>% NA_counter() # No NAs in whole data set
length(exp$gene) == length(unique(exp$gene)) # genes can functions as unique keys
exp <- column_to_rownames(exp, "gene")
NA_counter(exp)
NA_counter(annot)
NA_counter(annot, T)
for (i in colnames(annot)) {
if (length(unique(annot[,i])) <= 10) {annot[,i] <- annot[,i] %>% factor()}
}
annot <- annot %>% mutate(is.tumour = substring(rownames(annot), 14, 15)=="01")
data_splitter <- function(data, target, method="single", split=0.7, include.healthy=F, top.var.cutoff=50, annot.cols=21) {
if (method=="single") {
if (!include.healthy) data <- data[data$is.tumour,]
data <- data[!is.na(data[,target]),]
data.dat <- data[,{annot.cols+1}:ncol(data)]
top.var <- cbind(data[,target], data.dat[,names(sort(apply(data.dat, 2, var), decreasing=T)[1:top.var.cutoff])])
colnames(top.var)[1] <- target
selector <- sample(rownames(top.var), floor(nrow(top.var)*split))
anti.selector <- rownames(top.var)[!{rownames(top.var) %in% selector}]
training <- top.var[selector,]; testing <- top.var[anti.selector,]
return(list(training,testing))
} else if (strsplit(method,"-")[1]=="CV") {
tryCatch(x_vals <- strsplit(method, "-")[2] %>% as.numeric(), stop("For multiple crossvalidation method, use 'CV-[number of cross validations]."))
} else stop("Method needs to be 'single' or 'CV-[number of cross validations].")
}
target_dualler <- function(data, target, first.group, boolean) {
x <- data[[target]]
first <- tolower(x) %in% tolower(first.group)
data[,target] <- ifelse(first, boolean[1], boolean[2]) %>% factor()
data
}
data <- cbind(annot, t(exp))
data <- data_splitter(data, "expression_subtype")
training <- data[[1]]; testing <- data[[2]]
rf.reg <- randomForest(expression_subtype ~ ., data = training, importance = TRUE, ntree = 500)
mult.reg <- multinom(expression_subtype ~ ., data = training)
rf.pred <- predict(rf.reg, testing[,-1])
mult.pred <- predict(mult.reg, testing[,-1])
ggplot() +
geom_bar(aes(x=rf.pred), color="black", fill="white") +
labs(title="Distribution in Random Forest Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=mult.pred), color="black", fill="white") +
labs(title="Distribution in Multinomial Logistic Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=testing$expression_subtype), color="black", fill="white") +
labs(title="Distribution in Testing Data") +
theme_bw()
for (i in c("rf.pred","mult.pred")) {
confusionMatrix(get(i), testing$expression_subtype) %>% show()
}
roc_plotter <- function(reg, truth, title, multiclass=T) {
if (multiclass) {
rocs <- multiclass.roc(response = truth[,1], predictor = predict(reg, truth, type = "prob"))$rocs
len <- length(rocs)
colours <- heat.colors(len)
plot(rocs[1][[1]][[1]], col=colours[1], main=title)
for (i in 2:len) {lines(rocs[i][[1]][[1]], col=colours[i], lwd=2)}
legend("bottomright", legend = names(rocs), col=colours, lwd=2)
} else {
roc <- roc(response=testing[,1], predictor=predict(log.reg, testing[,-1]), levels=c("Early","Late"))
legname <- roc$levels; legname <- paste0(legname[1],"/",legname[2])
plot(roc, col = "red", main = title, lwd = 2)
legend("bottomright", legend = legname, col="red", lwd=2)
}
}
roc_plotter(rf.reg, testing, "Random Forest Regression")
roc_plotter(mult.reg, testing, "Multinomial Logistical Regression")
abs_imper <- function(data, mode) {
if (mode=="rf") {
imp.mat <- data[["importance"]]
abs.imp <- vector(length=nrow(imp.mat))
for (i in seq_len(length(abs.imp))) {
abs.imp[i] <- abs(imp.mat[i, 2]-imp.mat[i, 1])
}
names(abs.imp) <- rownames(imp.mat)
} else if (mode=="mult") {
imp.mat <- data %>% coef() %>% .[,-1]
abs.imp <- vector(length=ncol(imp.mat))
for (i in seq_len(length(abs.imp))) {
abs.imp[i] <- sqrt(imp.mat[1, i]^2+imp.mat[2, i]^2)
}
names(abs.imp) <- colnames(imp.mat)
} else if (mode=="binom") {
abs.imp <- data[["coefficients"]] %>% .[-1]
} else stop("Error: Tried to call function with unknown mode.")
return(abs.imp)
}
rf.abs.imp <- abs_imper(rf.reg, mode="rf") %>% sort(., T) %>% names() %>% .[1:50]
mult.abs.imp <- abs_imper(mult.reg, mode="mult") %>% sort(., T) %>% names() %>% .[1:50]
rf.abs.imp[rf.abs.imp %in% mult.abs.imp]
data <- cbind(annot, t(exp))
data <- data_splitter(data, "Tumor.stage", top.var.cutoff = 50)
training <- data[[1]]; testing <- data[[2]]
training <- target_dualler(training, "Tumor.stage", first.group=c("Stage IA","Stage IB","Stage IIA","Stage IIB"), boolean=c("Early","Late"))
testing <- target_dualler(testing, "Tumor.stage", first.group=c("Stage IA","Stage IB","Stage IIA","Stage IIB"), boolean=c("Early","Late"))
norm.prep <- preProcess(training[, -1], method = c("center", "scale"))
norm.training <- cbind("Tumor.stage"=training[,1], predict(norm.prep, training[,-1]))
norm.testing <- cbind("Tumor.stage"=testing[,1], predict(norm.prep, testing[,-1]))
rf.reg <- randomForest(Tumor.stage ~ ., data = training, importance = TRUE, ntree = 500)
log.reg <- glm(Tumor.stage ~ ., data = training, family = "binomial")
knn.reg <- train(Tumor.stage ~ ., data = norm.training,  method = "knn", tuneGrid=expand.grid(k = 1:10), trControl=trainControl(method = "cv", number = 5, classProbs = TRUE))
rf.pred <- predict(rf.reg, testing[,-1])
log.pred <- factor(ifelse(predict(log.reg, testing[,-1]) > 0.5, "Late", "Early"))
knn.pred <- predict(knn.reg, norm.testing, type = "prob")[, "Late"] %>% {factor(ifelse(. > 0.5, "Late", "Early"))}
ggplot() +
geom_bar(aes(x=rf.pred), color="black", fill="white") +
labs(title="Distribution in Random Forest Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=log.pred), color="black", fill="white") +
labs(title="Distribution in Multinomial Logistic Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=knn.pred), color="black", fill="white") +
labs(title="Distribution in k-Nearest Neighbours Prediction") +
theme_bw()
ggplot() +
geom_bar(aes(x=testing$Tumor.stage), color="black", fill="white") +
labs(title="Distribution in Testing Data") +
theme_bw()
for (i in c("rf.pred","log.pred")) {
confusionMatrix(get(i), testing$Tumor.stage) %>% show()
}
confusionMatrix(knn.pred, norm.testing$Tumor.stage)
roc_plotter(rf.reg, testing, "Random Forest Regression")
roc_plotter(log.reg, testing, "Binomial Logistical Regression", F)
rf.abs.imp <- abs_imper(rf.reg, mode="rf") %>% sort(., T) %>% names() %>% .[1:50]
log.abs.imp <- abs_imper(log.reg, mode="binom") %>% sort(., T) %>% names() %>% .[1:50]
rf.abs.imp[rf.abs.imp %in% log.abs.imp]
rf.abs.imp[rf.abs.imp %in% log.abs.imp]
log.abs.imp
rf.abs.imp
log.abs.imp
log.abs.im
rf.abs.imp
log.abs.imp
